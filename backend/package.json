{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:db && vitest run",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test:watch": "vitest",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "migrate:list": "knex --knexfile knexfile.cjs migrate:list",
    "seed": "knex --knexfile knexfile.cjs seed:run",
    "test:db": "knex --knexfile knexfile.cjs --env test migrate:latest",
    "test:db:rollback": "knex --knexfile knexfile.cjs --env test migrate:rollback",
    "test:watch:db": "knex --knexfile knexfile.cjs --env test migrate:latest && vitest",
    "test:seed": "knex --knexfile knexfile.cjs --env test seed:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-session-knex": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
